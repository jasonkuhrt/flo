{
  "name": "flo",
  "version": "0.0.0-dripip",
  "description": "Work items -> checkouts -> launchers -> agent context",
  "keywords": [
    "agents",
    "cmux",
    "git-worktree",
    "raycast",
    "workflow"
  ],
  "bugs": {
    "url": "https://github.com/jasonkuhrt/flo/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jason Kuhrt",
    "url": "https://kuhrt.me"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jasonkuhrt/flo.git"
  },
  "bin": {
    "flo": "./build/bin/flo.js"
  },
  "files": [
    "build",
    "README.md",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./build/exports/index.js"
  },
  "scripts": {
    "build:toc": "markdown-toc README.md -i --maxdepth 4 && oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --write README.md",
    "build:watch:emit": "bun run build --noCheck --watch",
    "build:watch": "bun run build --watch",
    "build:emit": "bun run build --noEmit",
    "build": "tsgo --build tsconfig.build.json",
    "build:raycast": "cd integrations/raycast && bun install --frozen-lockfile && bunx ray build",
    "build:clean": "tsgo --build --clean && rm -rf build",
    "prebuild": "bun run build:clean",
    "cli": "bun run src/bin/flo.ts",
    "dev:raycast": "cd integrations/raycast && bun install --frozen-lockfile && bunx ray develop",
    "raycast:install": "bun run src/bin/flo.ts raycast install",
    "raycast:uninstall": "bun run src/bin/flo.ts raycast uninstall",
    "raycast:status": "bun run src/bin/flo.ts raycast status",
    "test": "bun run test:unit",
    "test:unit": "bun test src",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=src/coverage src",
    "prepack": "bun run build && bun scripts/prepack-imports.ts",
    "postpack": "bun scripts/prepack-imports.ts --restore",
    "fix": "bun run fix:format && bun run fix:lint && bun run fix:raycast",
    "fix:format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --write",
    "fix:lint": "oxlint --type-aware --fix-dangerously --deny-warnings src scripts",
    "fix:raycast": "cd integrations/raycast && bun install --frozen-lockfile && bunx ray lint --fix",
    "check": "bun run check:format && bun run check:lint && bun run check:types && bun run test && bun run check:cov && bun run check:package && bun run check:exports && bun run check:ci && bun run check:raycast",
    "check:format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --check",
    "check:lint": "oxlint --type-aware --deny-warnings src scripts",
    "check:types": "tsgo",
    "check:cov": "bun run test:coverage && bun scripts/check-coverage.ts src/coverage/lcov.info 90 90",
    "check:test:cov": "bun scripts/check-staged-coverage.ts src/coverage/lcov.info 90",
    "check:package": "bun run build && publint run --strict",
    "check:exports": "bun run build && attw --pack . --profile esm-only",
    "check:ci": "actionlint",
    "check:raycast": "bun run lint:raycast && bun run build:raycast",
    "lint:raycast": "cd integrations/raycast && bun install --frozen-lockfile && bunx ray lint"
  },
  "dependencies": {
    "@effect/platform": "^0.94.5",
    "@effect/platform-node": "^0.104.1",
    "effect": "^3.19.19",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "^1.3.10",
    "@types/node": "25.3.5",
    "@typescript/native-preview": "7.0.0-dev.20260306.1",
    "dripip": "0.10.0",
    "fast-glob": "3.3.3",
    "lint-staged": "^16.4.0",
    "markdown-toc": "1.2.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.16.0",
    "publint": "^0.3.18",
    "typescript": "5.9.3"
  }
}
